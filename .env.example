# snapatch 환경변수 예시 — 이 파일을 .env 로 복사해서 값을 채우세요.
#   cp .env.example .env   (Windows: copy .env.example .env)

# ===== breaker (시황 속보, Gemini) =====
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택: 기본 모델
GEMINI_MODEL=gemini-2.5-flash
# 선택: 매체 목록 덮어쓰기 — 콤마 구분
# BRIEFING_SOURCES=한국경제, 연합뉴스, Bloomberg, Reuters

# ===== diver (네이버 뉴스 + Vertex AI Gemini) =====
# 네이버 개발자센터 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Vertex AI (gcloud auth application-default login 으로 인증)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# 선택: 서비스 계정 키 경로
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 선택: diver 실행 옵션
VERTEX_MODEL=gemini-2.5-flash
DEFAULT_TARGET_COUNT=5
DEFAULT_MAX_DAYS=30
SKIP_CONTENT=false
ARTICLE_TIMEOUT_SECONDS=3
ARTICLE_MAX_WORKERS=10
CONTENT_PREVIEW_LENGTH=300
FILTER_SIMILAR_NEWS=true
NEWS_SIMILARITY_THRESHOLD=0.82
NEWS_TOKEN_OVERLAP_THRESHOLD=0.55
POST_FILTER_SIMILAR_NEWS=true
POST_NEWS_KEYWORD_OVERLAP_THRESHOLD=0.55
POST_NEWS_KEYWORD_MIN_COMMON=5
DEFAULT_OUTPUT_FORMAT=text

# ===== match (유사 종목 검색, pykrx data.krx) =====
# pykrx 1.2+ data.krx 조회용 (없으면 무인증 조회 시도, UI 에서도 입력 가능)
KRX_ID=
KRX_PW=
